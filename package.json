{
  "name": "yedu",
  "version": "0.1.0",
  "browserslist": [
    "firefox 63",
    "chrome 70"
  ],
  "scripts": {
    "test": "playwright test",
    "test:extension": "node tests/extension-smoke.cjs",
    "test:background": "node --test tests/background-audio.cjs",
    "build": "npx gulp",
    "build:local-sourcemaps": "npx gulp --local-sourcemaps",
    "build:sign": "npx gulp --sign",
    "polyfill": "npx webpack --entry=./polyfill.js --output-path=./src/lib --output-filename=polyfill.js -d inline-source-map",
    "build:ai": "webpack --config webpack.ai.cjs",
    "build:ocr": "webpack --config webpack.ocr.cjs",
    "test:image": "node tests/image-translation-extension.cjs",
    "test:region-cache-ui": "node --test tests/region-capture-background.cjs && node tests/region-cache-ui-extension.cjs",
    "test:image-layout": "node --test tests/image-ocr-layout.cjs",
    "test:ai": "node --test tests/ai-service.cjs tests/presets.cjs tests/ai-insights.cjs tests/ai-transport.cjs",
    "test:ai-insights": "node tests/ai-insights-extension.cjs",
    "test:ai-scope": "node tests/ai-scope-extension.cjs",
    "test:web-cache": "node tests/web-cache-extension.cjs",
    "test:context-lifecycle": "node --test tests/selection-context.cjs && node tests/context-lifecycle-extension.cjs",
    "test:context-upgrade": "node tests/context-upgrade-extension.cjs",
    "test:ai-extension": "node tests/ai-extension.cjs",
    "test:ai-resilience": "node tests/ai-resilience-extension.cjs",
    "test:sidebar": "node --test tests/documents.cjs tests/sidepanel-background.cjs tests/pdf-cache.cjs",
    "test:pdf-cache": "node tests/pdf-cache-extension.cjs",
    "test:pdf-auto": "node tests/pdf-auto-extension.cjs",
    "test:pdf-tools": "node tests/pdf-tools-extension.cjs",
    "test:pdf-sync": "node tests/pdf-sync-extension.cjs",
    "test:pdf-typeset": "node tests/pdf-typeset-extension.cjs",
    "test:pdf-math": "node tests/pdf-math-extension.cjs",
    "test:release": "node --test tests/release.cjs",
    "licenses": "node scripts/collect-licenses.cjs",
    "test:pdf-inline": "node --test tests/pdf-inline-math.cjs",
    "test:pdf-inline-extension": "node tests/pdf-inline-math-extension.cjs",
    "test:pdf-structure": "node --test tests/pdf-structure.cjs",
    "test:pdf-structure-extension": "node tests/pdf-structure-extension.cjs",
    "test:pdf-cover": "node tests/pdf-cover-extension.cjs",
    "test:pdf-figure-alignment": "node tests/pdf-figure-alignment-extension.cjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.62",
    "@paddleocr/paddleocr-js": "0.4.2",
    "ai": "^7.0.127",
    "core-js": "^3.26.1",
    "htmlparser2": "^10.0.0",
    "onnxruntime-web": "1.24.3",
    "pdfjs-dist": "6.3.289"
  },
  "devDependencies": {
    "@babel/preset-env": "^8.0.2",
    "@playwright/test": "^1.63.0",
    "@types/chrome": "latest",
    "@types/firefox-webext-browser": "latest",
    "crx3": "^2.0.0",
    "gulp": "^5.0.0",
    "gulp-babel": "^8.0.0",
    "gulp-sourcemaps": "^2.6.5",
    "gulp-zip": "^5.1.0",
    "node-file-dialog": "^1.0.3",
    "webpack": "^5.105.0",
    "webpack-cli": "^7.2.2"
  },
  "allowScripts": {
    "core-js@3.50.0": true,
    "es5-ext": false
  },
  "private": true,
  "license": "MPL-2.0",
  "description": "Bilingual webpage translation, multi-model text comparison, and customizable AI experts.",
  "repository": {
    "type": "git",
    "url": "https://github.com/jacking9898/twp-ai.git"
  },
  "homepage": "https://github.com/jacking9898/twp-ai",
  "bugs": {
    "url": "https://github.com/jacking9898/twp-ai/issues"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
